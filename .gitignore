# Jira credentials — real API token, never commit.
# Copy jira-config.example.json to jira-config.json and fill it in locally.
.env
jira-config.json

# Sign-in credentials and live sessions. server.js seeds a super admin into
# this on first run and prints the password once; password hashes and
# session tokens live here, so it never belongs in the repo.
auth.json

# Runtime state. server.js recreates this from the seed in js/data.js on
# first run, and it accumulates live ticket data, internal URLs and names.
shared-state.json

node_modules/

