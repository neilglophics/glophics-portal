# Jira credentials — real API token, never commit.
# Copy jira-config.example.json to jira-config.json and fill it in locally.
.env
jira-config.json

# Who may reach the portal at all. Real office/VPN addresses, and a list
# that differs per deployment — copy allowed-ips.example.json instead.
allowed-ips.json

# Sign-in credentials and live sessions. server.js seeds a super admin into
# this on first run and prints the password once; password hashes and
# session tokens live here, so it never belongs in the repo.
auth.json

# Runtime state: the board, one file per section. state-store.js recreates it
# from the seed in js/data.js on first run, and it accumulates live ticket
# data, internal URLs and names.
shared-data/
shared-data.unreadable*/

# The single file the board used to live in, kept after it is split.
shared-state*.json*

node_modules/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/

# Next.js
.next/
next-env.d.ts
.vercel

# Local env files
.env
.env*.local

# Build artifact, not source.
tsconfig.tsbuildinfo

# Real credentials, kept out of git. sample_env was committed by accident once;
# it holds live values, not a template.
sample_env
sample.env
*.env.real
