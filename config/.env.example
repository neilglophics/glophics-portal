# Copy this file to config/.env and fill it in. That file is gitignored;
# this one is the template committed to the repo.

# Required. mysql://user:password@host:port/database
DATABASE_URL=mysql://server_mgmt:changeme@127.0.0.1:3306/server_management

# Required in production. In development, a key is generated into
# config/secret.key on first run if this is left blank — convenient for a
# local clone, not something to rely on anywhere that matters. Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_SECRET_KEY=

# Set together with APP_SECRET_KEY only while rotating keys — see
# `node server/cli/admin.js rotate-secret-key`.
# APP_SECRET_KEY_PREVIOUS=

# development | test | production. Production refuses to boot without
# ADMIN_PASSWORD (no built-in default) and without APP_SECRET_KEY.
NODE_ENV=development

PORT=6767

# Only the first run uses these, to create the first super admin. Outside
# production, leaving ADMIN_PASSWORD blank generates a random one and prints
# it once — write it down, or sign in immediately and change it.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# auto | true | false. "auto" sends Secure only when the request itself
# arrived over TLS (or, with TRUST_PROXY set, when a trusted proxy says it
# did). Force "true" once you are certain every request is HTTPS.
COOKIE_SECURE=auto

# Only needed if this deployment's Jira credentials should come from the
# environment rather than the Settings page — set all three to make
# GET /api/jira-config report managedByEnv:true and disable the form.
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# auto | strict | standard. "auto" tightens the sign-in throttle whenever
# the IP allowlist (config/allowed-ips.json) is left open.
AUTH_THROTTLE_PROFILE=auto
