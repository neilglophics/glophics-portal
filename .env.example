# ── Neon Postgres ────────────────────────────────────────────────────────────
# DATABASE_URL must be the POOLED string (…-pooler.<region>.aws.neon.tech).
# A serverless function must never open an unpooled pool: invocations scale out
# independently and would exhaust Postgres connections.
DATABASE_URL="postgresql://neondb_owner:npg_6YEI9iHWtvQw@ep-snowy-violet-az22dsad-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# The DIRECT string, used only by `npm run db:migrate`. DDL through a pooler in
# transaction mode can land on different backends between statements.
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:npg_6YEI9iHWtvQw@ep-snowy-violet-az22dsad-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── The gate ─────────────────────────────────────────────────────────────────
# Who may reach the app at all. Plain IPs, CIDR blocks, or the aliases
# `lan` / `loopback`. Comma or whitespace separated.
#
# EMPTY MEANS: refuse everything in production, allow everything in development.
# That is the opposite of the legacy app, which failed open so a missing env var
# could not lock a team out of a portal on their own LAN. On a public URL that
# rule would silently expose the board. See docs/06-OPEN-QUESTIONS.md Q3.
ALLOWED_IPS="58.69.17.146"
# Loopback is allowed even when a list is in force, unless this is "false".
ALLOW_LOOPBACK="true"

# ── First run ────────────────────────────────────────────────────────────────
# Creates the first super admin on the first sign-in attempt, IF AND ONLY IF
# auth_users is completely empty. Minimum 8 characters.
#
# ⚠ Once ANY account exists, these are IGNORED. Changing ADMIN_PASSWORD does
# NOT change an existing account's password — an env var able to overwrite a
# live credential would be a permanent backdoor into every deployment that set
# it. There is no error either, because seeding is simply skipped.
#
# So after `npm run db:import` brings accounts over from the legacy
# config/auth.json, they keep their ORIGINAL passwords: the scrypt parameters
# are unchanged, so the old hashes still verify. To change one:
#
#   npm run auth:list
#   npm run auth:set-password -- <username> <newpassword>
#
# Also note: THIS FILE IS A COMMITTED TEMPLATE AND IS NEVER READ. Real values
# belong in .env.local (preferred) or .env, both gitignored. Never put a real
# secret here.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# ── Cron (Phase 6) ───────────────────────────────────────────────────────────
# Cron routes are public URLs. Without this, anyone can trigger a Jira sync or
# an expiry sweep at will.
CRON_SECRET=""

# ── Jira ─────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""

# ── Pusher (Phase 7) ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_PUSHER_KEY is public by design and ships in the browser bundle.
# PUSHER_SECRET is server-only and must NEVER be prefixed NEXT_PUBLIC_.
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# ── Vercel Blob (Phase 11) ───────────────────────────────────────────────────
# Set automatically by the Vercel Blob integration.
BLOB_READ_WRITE_TOKEN=""
